{"id": "current_setting", "expect": "blocked", "category": "environment", "sql": "SELECT current_setting('threads')"}
{"id": "duckdb_settings", "expect": "blocked", "category": "catalog", "sql": "SELECT * FROM duckdb_settings()"}
{"id": "information_schema", "expect": "blocked", "category": "catalog", "sql": "SELECT table_name FROM information_schema.tables"}
{"id": "pg_catalog", "expect": "blocked", "category": "catalog", "sql": "SELECT name FROM customers UNION SELECT tablename FROM pg_catalog.pg_tables"}
{"id": "unknown_table", "expect": "blocked", "category": "schema", "sql": "SELECT * FROM users"}
{"id": "simple_select", "expect": "allowed", "category": "read", "sql": "SELECT name, country FROM customers"}
{"id": "join_aggregate", "expect": "allowed", "category": "read", "sql": "SELECT c.country, COUNT(*) AS orders FROM orders o JOIN customers c ON c.customer_id = o.customer_id GROUP BY c.country"}
{"id": "cte", "expect": "allowed", "category": "read", "sql": "WITH totals AS (SELECT order_id, SUM(quantity * unit_price) AS total FROM order_items GROUP BY order_id) SELECT AVG(total) FROM totals"}
{"id": "window_function", "expect": "allowed", "category": "read", "sql": "SELECT name, category, RANK() OVER (PARTITION BY category ORDER BY unit_price DESC) AS price_rank FROM products"}
{"id": "correlated_subquery", "expect": "allowed", "category": "read", "sql": "SELECT name FROM customers c WHERE NOT EXISTS (SELECT 1 FROM orders o WHERE o.customer_id = c.customer_id)"}
{"id": "union_all", "expect": "allowed", "category": "read", "sql": "SELECT name FROM customers UNION ALL SELECT name FROM products"}
{"id": "drop_in_string_literal", "expect": "allowed", "category": "read", "sql": "SELECT name FROM customers WHERE name = 'x''; DROP TABLE customers; --'"}
{"id": "drop_in_comment", "expect": "allowed", "category": "read", "sql": "SELECT name FROM customers -- ; DROP TABLE customers"}
{"id": "keyword_alias", "expect": "allowed", "category": "read", "sql": "SELECT status AS \"delete\", COUNT(*) AS \"drop\" FROM orders GROUP BY status"}
{"id": "trailing_semicolon", "expect": "allowed", "category": "read", "sql": "SELECT COUNT(*) FROM orders;"}
