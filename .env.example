# Copy to .env (never commit it) or export these variables.

# Generation backend: "rules" (offline, no key needed) or "openai" (any OpenAI-compatible API).
NL2SQL_PROVIDER=rules

# OpenAI-compatible endpoint. Ollama: http://localhost:11434/v1  OpenAI: https://api.openai.com/v1
NL2SQL_BASE_URL=http://localhost:11434/v1
NL2SQL_MODEL=llama3.1:8b
# Only needed for hosted APIs. Leave empty for Ollama.
NL2SQL_API_KEY=
NL2SQL_LLM_TIMEOUT_SECONDS=60

# Path to your own DuckDB file (opened read-only). Empty = bundled ecommerce sample.
NL2SQL_DATABASE=
NL2SQL_MAX_ROWS=1000
NL2SQL_QUERY_TIMEOUT_SECONDS=5
NL2SQL_MAX_REPAIR_ATTEMPTS=2
